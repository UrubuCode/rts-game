@@ -0,0 +1,14 @@
+@group(0) @binding(0) var hdr: texture_2d<f32>;
+@group(0) @binding(1) var<uniform> settings: vec4<f32>;
+@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {
+    let x = f32((i << 1u) & 2u); let y = f32(i & 2u);
+    return vec4<f32>(x * 2.0 - 1.0, y * 2.0 - 1.0, 0.0, 1.0);
+}
+@fragment fn fs(@builtin(position) p: vec4<f32>) -> @location(0) vec4<f32> {
+    let src = textureLoad(hdr, vec2<i32>(p.xy), 0);
+    if (settings.x <= 0.0) { return src; }
+    let x = max(src.rgb * settings.x, vec3<f32>(0.0));
+    // ACES fitted curve. Output stays linear; the sRGB target performs encoding.
+    let mapped = clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), vec3<f32>(0.0), vec3<f32>(1.0));
+    return vec4<f32>(mapped, src.a);
+}
