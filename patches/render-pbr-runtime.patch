diff --git a/crates/rts-egui/src/frame/scene3d/capture.rs b/crates/rts-egui/src/frame/scene3d/capture.rs
new file mode 100644
index 0000000..e3eae24
--- /dev/null
+++ b/crates/rts-egui/src/frame/scene3d/capture.rs
@@ -0,0 +1,37 @@
+//! Read back the queued scene without depending on desktop/window capture.
+//! Explicit diagnostic operation: synchronizes the GPU and consumes the queue.
+use super::*;
+impl Scene3D {
+    pub fn capture(&mut self, device: &wgpu::Device, queue: &wgpu::Queue, width: u32, height: u32,
+        format: wgpu::TextureFormat) -> Result<Vec<u8>, String> {
+        if width == 0 || height == 0 || width > 4096 || height > 4096 { return Err("capture dimensions must be 1..4096".into()); }
+        if !matches!(format, wgpu::TextureFormat::Rgba8Unorm | wgpu::TextureFormat::Rgba8UnormSrgb | wgpu::TextureFormat::Bgra8Unorm | wgpu::TextureFormat::Bgra8UnormSrgb) {
+            return Err("capture requires an RGBA8/BGRA8 output".into());
+        }
+        let size=wgpu::Extent3d {width,height,depth_or_array_layers:1};
+        let target=device.create_texture(&wgpu::TextureDescriptor {label:Some("scene capture"),size,mip_level_count:1,sample_count:1,
+            dimension:wgpu::TextureDimension::D2,format,usage:wgpu::TextureUsages::RENDER_ATTACHMENT|wgpu::TextureUsages::COPY_SRC,view_formats:&[]});
+        let view=target.create_view(&Default::default());
+        let stride=(width*4).div_ceil(256)*256;
+        let buffer=device.create_buffer(&wgpu::BufferDescriptor {label:Some("scene capture readback"),size:(stride*height) as u64,
+            usage:wgpu::BufferUsages::COPY_DST|wgpu::BufferUsages::MAP_READ,mapped_at_creation:false});
+        let mut encoder=device.create_command_encoder(&Default::default());
+        self.render(device,queue,&mut encoder,&view,width,height);
+        encoder.copy_texture_to_buffer(wgpu::TexelCopyTextureInfo {texture:&target,mip_level:0,origin:wgpu::Origin3d::ZERO,aspect:wgpu::TextureAspect::All},
+            wgpu::TexelCopyBufferInfo {buffer:&buffer,layout:wgpu::TexelCopyBufferLayout {offset:0,bytes_per_row:Some(stride),rows_per_image:Some(height)}},size);
+        let submission=queue.submit([encoder.finish()]);
+        let (tx,rx)=std::sync::mpsc::channel();
+        buffer.slice(..).map_async(wgpu::MapMode::Read,move |r| {let _=tx.send(r);});
+        device.poll(wgpu::PollType::Wait {submission_index:Some(submission),timeout:Some(std::time::Duration::from_secs(30))}).map_err(|e|e.to_string())?;
+        rx.recv_timeout(std::time::Duration::from_secs(30)).map_err(|e|e.to_string())?.map_err(|e|e.to_string())?;
+        let bgra=matches!(format,wgpu::TextureFormat::Bgra8Unorm|wgpu::TextureFormat::Bgra8UnormSrgb);
+        let mut out=format!("P6\n{width} {height}\n255\n").into_bytes();
+        {
+            let mapped=buffer.slice(..).get_mapped_range();
+            for row in mapped.chunks_exact(stride as usize) {for px in row[..width as usize*4].chunks_exact(4) {
+                if bgra {out.extend_from_slice(&[px[2],px[1],px[0]]);} else {out.extend_from_slice(&px[..3]);}
+            }}
+        }
+        buffer.unmap();Ok(out)
+    }
+}
diff --git a/crates/rts-egui/src/frame/scene3d/mipmaps.rs b/crates/rts-egui/src/frame/scene3d/mipmaps.rs
new file mode 100644
index 0000000..5b505c3
--- /dev/null
+++ b/crates/rts-egui/src/frame/scene3d/mipmaps.rs
@@ -0,0 +1,116 @@
+//! Upload-time mip generation. Color maps are averaged in linear light;
+//! normal/MR/AO data maps must never receive an sRGB conversion.
+pub(crate) struct PreparedTexture {
+    pub levels: Vec<Vec<u8>>,
+    pub width: u32,
+    pub height: u32,
+    pub data: bool,
+}
+pub(crate) fn prepare(rgba: Vec<u8>, w: u32, h: u32, data: bool) -> PreparedTexture {
+    let mut result = PreparedTexture {
+        levels: vec![rgba],
+        width: w,
+        height: h,
+        data,
+    };
+    let (mut width, mut height) = (w, h);
+    while width > 1 || height > 1 {
+        let next = downsample(result.levels.last().unwrap(), width, height, data);
+        result.levels.push(next);
+        width = (width / 2).max(1);
+        height = (height / 2).max(1);
+    }
+    result
+}
+pub(super) fn upload_prepared(
+    queue: &wgpu::Queue,
+    tex: &wgpu::Texture,
+    prepared: &PreparedTexture,
+) {
+    let (mut w, mut h) = (prepared.width, prepared.height);
+    for (level, pixels) in prepared.levels.iter().enumerate() {
+        queue.write_texture(
+            wgpu::TexelCopyTextureInfo {
+                texture: tex,
+                mip_level: level as u32,
+                origin: wgpu::Origin3d::ZERO,
+                aspect: wgpu::TextureAspect::All,
+            },
+            pixels,
+            wgpu::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(w * 4),
+                rows_per_image: Some(h),
+            },
+            wgpu::Extent3d {
+                width: w,
+                height: h,
+                depth_or_array_layers: 1,
+            },
+        );
+        w = (w / 2).max(1);
+        h = (h / 2).max(1);
+    }
+}
+pub(super) fn linear(x: f32) -> f32 {
+    if x <= 0.04045 {
+        x / 12.92
+    } else {
+        ((x + 0.055) / 1.055).powf(2.4)
+    }
+}
+fn srgb(x: f32) -> f32 {
+    if x <= 0.0031308 {
+        x * 12.92
+    } else {
+        1.055 * x.powf(1.0 / 2.4) - 0.055
+    }
+}
+fn downsample(src: &[u8], w: u32, h: u32, data: bool) -> Vec<u8> {
+    let nw = (w / 2).max(1);
+    let nh = (h / 2).max(1);
+    let mut out = vec![0; (nw * nh * 4) as usize];
+    for y in 0..nh {
+        for x in 0..nw {
+            // Integer regions include the last row/column of odd-sized textures.
+            let (x0, x1) = (x * w / nw, (x + 1) * w / nw);
+            let (y0, y1) = (y * h / nh, (y + 1) * h / nh);
+            let count = ((x1 - x0) * (y1 - y0)) as f32;
+            for c in 0..4 {
+                let mut sum = 0.0;
+                for sy in y0..y1 {
+                    for sx in x0..x1 {
+                        let v = src[((sy * w + sx) * 4 + c) as usize] as f32 / 255.0;
+                        sum += if data || c == 3 { v } else { linear(v) };
+                    }
+                }
+                let v = sum / count;
+                out[((y * nw + x) * 4 + c) as usize] =
+                    ((if data || c == 3 { v } else { srgb(v) }) * 255.0).round() as u8;
+            }
+        }
+    }
+    out
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn color_is_filtered_in_linear_light_and_data_is_not() {
+        let pixels = [0, 0, 0, 255, 255, 255, 255, 255];
+        assert_eq!(downsample(&pixels, 2, 1, false), [188, 188, 188, 255]);
+        assert_eq!(downsample(&pixels, 2, 1, true), [128, 128, 128, 255]);
+    }
+    #[test]
+    fn odd_texture_includes_last_texel() {
+        assert_eq!(
+            downsample(
+                &[0, 0, 0, 255, 0, 0, 0, 255, 255, 255, 255, 255],
+                3,
+                1,
+                true
+            ),
+            [85, 85, 85, 255]
+        );
+    }
+}
diff --git a/crates/rts-egui/src/frame/scene3d/pbr.rs b/crates/rts-egui/src/frame/scene3d/pbr.rs
new file mode 100644
index 0000000..6d75e48
--- /dev/null
+++ b/crates/rts-egui/src/frame/scene3d/pbr.rs
@@ -0,0 +1,88 @@
+//! Material resources for the existing scene queue. Texture handles are owned
+//! by Scene3D; material handles occupy a separate namespace and are reusable.
+use super::*;
+
+pub(super) struct MaterialGpu {
+    pub data: [f64; 11],
+    pub bg: wgpu::BindGroup,
+}
+
+pub(super) fn layout(device: &wgpu::Device) -> wgpu::BindGroupLayout {
+    let mut entries = vec![wgpu::BindGroupLayoutEntry {
+        binding: 0, visibility: wgpu::ShaderStages::FRAGMENT,
+        ty: wgpu::BindingType::Buffer { ty: wgpu::BufferBindingType::Uniform,
+            has_dynamic_offset: false, min_binding_size: wgpu::BufferSize::new(48) }, count: None,
+    }];
+    for binding in 1..=5 {
+        entries.push(wgpu::BindGroupLayoutEntry { binding, visibility: wgpu::ShaderStages::FRAGMENT,
+            ty: wgpu::BindingType::Texture { sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                view_dimension: wgpu::TextureViewDimension::D2, multisampled: false }, count: None });
+    }
+    entries.push(wgpu::BindGroupLayoutEntry { binding: 6, visibility: wgpu::ShaderStages::FRAGMENT,
+        ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering), count: None });
+    device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor { label: Some("PBR material"), entries: &entries })
+}
+
+fn finite(x: f64, fallback: f64) -> f32 { if x.is_finite() { x as f32 } else { fallback as f32 } }
+
+/// metallic, roughness, normalScale, occlusionStrength, emissive RGB,
+/// normalTexture, metallicRoughnessTexture, occlusionTexture, emissiveTexture.
+pub(super) fn uniform(data: &[f64; 11], enabled: bool) -> [f32; 12] {
+    [finite(data[0], 0.0).clamp(0.0, 1.0), finite(data[1], 1.0).clamp(0.045, 1.0),
+     finite(data[2], 1.0).clamp(0.0, 8.0), finite(data[3], 1.0).clamp(0.0, 1.0),
+     finite(data[4], 0.0).clamp(0.0, 65504.0), finite(data[5], 0.0).clamp(0.0, 65504.0),
+     finite(data[6], 0.0).clamp(0.0, 65504.0), if enabled { 1.0 } else { 0.0 },
+     if data[7] >= 2.0 { 1.0 } else { 0.0 }, if data[8] >= 2.0 { 1.0 } else { 0.0 },
+     if data[9] >= 2.0 { 1.0 } else { 0.0 }, if data[10] >= 2.0 { 1.0 } else { 0.0 }]
+}
+
+impl Scene3D {
+    pub fn set_material(&mut self, device: &wgpu::Device, id: u64, src: &[f64]) -> u64 {
+        if src.len() != 11 || src.iter().any(|x| !x.is_finite()) { return 0; }
+        let mut data = [0.0; 11]; data.copy_from_slice(src);
+        let id = if id == 0 { let id = self.next_material; self.next_material += 1; id }
+            else if self.materials.contains_key(&id) { id } else { return 0; };
+        let bg = self.make_material(device, &data, true);
+        self.materials.insert(id, MaterialGpu { data, bg });
+        id
+    }
+    pub fn free_material(&mut self, id: u64) { self.materials.remove(&id); }
+    pub fn last_material(&mut self, id: u64) {
+        if let Some(draw) = self.draws.last_mut() { draw.7 = id; }
+    }
+    pub(super) fn make_material(&self, device: &wgpu::Device, data: &[f64; 11], enabled: bool) -> wgpu::BindGroup {
+        let buf = init_buffer(device, "PBR parameters", f32_bytes(&uniform(data, enabled)), wgpu::BufferUsages::UNIFORM);
+        let view = |id: f64| self.texture_views.get(&(id as u64)).unwrap_or(&self.default_tex_view);
+        let sky = self.texture_views.get(&self.sky.textura).unwrap_or(&self.default_tex_view);
+        device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("PBR maps"), layout: &self.material_bgl,
+            entries: &[
+                wgpu::BindGroupEntry { binding: 0, resource: buf.as_entire_binding() },
+                wgpu::BindGroupEntry { binding: 1, resource: wgpu::BindingResource::TextureView(view(data[7])) },
+                wgpu::BindGroupEntry { binding: 2, resource: wgpu::BindingResource::TextureView(view(data[8])) },
+                wgpu::BindGroupEntry { binding: 3, resource: wgpu::BindingResource::TextureView(view(data[9])) },
+                wgpu::BindGroupEntry { binding: 4, resource: wgpu::BindingResource::TextureView(view(data[10])) },
+                wgpu::BindGroupEntry { binding: 5, resource: wgpu::BindingResource::TextureView(sky) },
+                wgpu::BindGroupEntry { binding: 6, resource: wgpu::BindingResource::Sampler(&self.tex_sampler) },
+            ],
+        })
+    }
+    pub(super) fn refresh_material_environment(&mut self, device: &wgpu::Device) {
+        if self.material_sky == self.sky.textura { return; }
+        self.material_sky = self.sky.textura;
+        let updates: Vec<_> = self.materials.iter().map(|(&id, m)| (id, self.make_material(device, &m.data, true))).collect();
+        for (id, bg) in updates { self.materials.get_mut(&id).unwrap().bg = bg; }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn material_clamps_and_keeps_hdr_emission() {
+        let p = uniform(&[2.0, 0.0, 1.0, -1.0, 8.0, 2.0, 1.0, 2.0, 0.0, 0.0, 0.0], true);
+        assert_eq!(&p[..4], &[1.0, 0.045, 1.0, 0.0]);
+        assert_eq!(&p[4..8], &[8.0, 2.0, 1.0, 1.0]);
+        assert_eq!(&p[8..], &[1.0, 0.0, 0.0, 0.0]);
+    }
+}
diff --git a/crates/rts-egui/src/frame/scene3d/pbr.wgsl b/crates/rts-egui/src/frame/scene3d/pbr.wgsl
new file mode 100644
index 0000000..286fb56
--- /dev/null
+++ b/crates/rts-egui/src/frame/scene3d/pbr.wgsl
@@ -0,0 +1,86 @@
+struct PbrMaterial { surface: vec4<f32>, emission: vec4<f32>, maps: vec4<f32> };
+@group(3) @binding(0) var<uniform> pbr: PbrMaterial;
+@group(3) @binding(1) var pbr_normal_tex: texture_2d<f32>;
+@group(3) @binding(2) var pbr_mr: texture_2d<f32>;
+@group(3) @binding(3) var pbr_ao: texture_2d<f32>;
+@group(3) @binding(4) var pbr_emission: texture_2d<f32>;
+@group(3) @binding(5) var pbr_environment: texture_2d<f32>;
+@group(3) @binding(6) var pbr_sampler: sampler;
+
+fn srgb_linear(c: vec3<f32>) -> vec3<f32> {
+    return select(pow((c + 0.055) / 1.055, vec3<f32>(2.4)), c / 12.92, c <= vec3<f32>(0.04045));
+}
+fn safe_unit(v: vec3<f32>) -> vec3<f32> { return v * inverseSqrt(max(dot(v,v), 0.00000001)); }
+
+// Derivative cotangent frame supports imported UVs, mirrored islands and the
+// existing world projection, without requiring tangents in legacy mesh buffers.
+fn pbr_normal(world: vec3<f32>, normal: vec3<f32>, uv: vec2<f32>) -> vec3<f32> {
+    let n = safe_unit(normal);
+    let q1 = dpdx(world); let q2 = dpdy(world);
+    let st1 = dpdx(uv); let st2 = dpdy(uv);
+    let p2 = cross(q2, n); let p1 = cross(n, q1);
+    let t = p2 * st1.x + p1 * st2.x;
+    let b = p2 * st1.y + p1 * st2.y;
+    let len = max(dot(t,t), dot(b,b));
+    let inv = inverseSqrt(max(len, 0.00000001));
+    let sample_n = textureSample(pbr_normal_tex, pbr_sampler, uv).xyz * 2.0 - 1.0;
+    let mapped = safe_unit(t * inv * sample_n.x * pbr.surface.z + b * inv * sample_n.y * pbr.surface.z + n * sample_n.z);
+    return select(n, mapped, pbr.maps.x > 0.5 && len > 0.00000001);
+}
+fn fresnel(f0: vec3<f32>, cos_theta: f32) -> vec3<f32> {
+    return f0 + (vec3<f32>(1.0) - f0) * pow(clamp(1.0 - cos_theta, 0.0, 1.0), 5.0);
+}
+fn brdf(base: vec3<f32>, metallic: f32, rough: f32, n: vec3<f32>, v: vec3<f32>, l: vec3<f32>) -> vec3<f32> {
+    let h = safe_unit(v+l); let nl = max(dot(n,l),0.0); let nv = max(dot(n,v),0.0001);
+    let nh = max(dot(n,h),0.0); let vh = max(dot(v,h),0.0);
+    let a = rough * rough; let a2 = a*a;
+    let denom = nh*nh*(a2-1.0)+1.0;
+    let d = a2 / max(3.14159265*denom*denom, 0.0000001);
+    // Height-correlated Smith visibility (GGX).
+    let gv = nl * sqrt(nv*nv*(1.0-a2)+a2);
+    let gl = nv * sqrt(nl*nl*(1.0-a2)+a2);
+    let visibility = 0.5 / max(gv+gl, 0.00001);
+    let f = fresnel(mix(vec3<f32>(0.04),base,metallic),vh);
+    let diffuse = (vec3<f32>(1.0)-f)*(1.0-metallic)*base/3.14159265;
+    return (diffuse + d*visibility*f)*nl;
+}
+fn environment(dir: vec3<f32>, rough: f32) -> vec3<f32> {
+    let lod = rough * f32(textureNumLevels(pbr_environment)-1u);
+    let pano = textureSampleLevel(pbr_environment, pbr_sampler, equiret(dir), lod).rgb;
+    return cor_do_ceu(dir,pano);
+}
+fn shade_pbr(i: VOut, albedo: vec3<f32>, n: vec3<f32>, mr: vec4<f32>, ao_sample: f32, emission: vec3<f32>, shadow: f32) -> vec3<f32> {
+    // Vertex tint is sRGB; albedo texture has already been hardware-decoded.
+    let tint = srgb_linear(i.color.rgb);
+    let ratio = tint / max(i.color.rgb,vec3<f32>(0.00001));
+    let base = albedo * ratio;
+    let metallic = pbr.surface.x * select(1.0,mr.b,pbr.maps.y>0.5);
+    let rough = clamp(pbr.surface.y * select(1.0,mr.g,pbr.maps.y>0.5),0.045,1.0);
+    let ao = mix(1.0,select(1.0,ao_sample,pbr.maps.z>0.5),pbr.surface.w);
+    let v = safe_unit(cam.cam_pos.xyz-i.world);
+    let f0 = mix(vec3<f32>(0.04),base,metallic);
+    let f = fresnel(f0,max(dot(n,v),0.0));
+    let reflection = reflect(-v,n);
+    // First IBL tier: mip-filtered panorama / procedural sky. It is deliberately
+    // an approximation; irradiance convolution and GGX prefiltering come later.
+    let ambient = environment(n,1.0)*base*(1.0-metallic)*(vec3<f32>(1.0)-f);
+    let reflected = environment(reflection,rough)*f*(1.0-rough*0.5);
+    var rgb = (ambient+reflected)*env.info.w*ao;
+    let count = min(u32(env.info.x),8u);
+    if (count == 0u) {
+        rgb += brdf(base,metallic,rough,n,v,safe_unit(cam.light.xyz-i.world))*shadow*(1.0-cam.light.w);
+    }
+    for (var k = 0u; k < count; k += 1u) {
+        let light = env.lights[k]; var l = -safe_unit(light.b.xyz); var att = 1.0;
+        if (light.a.w > 0.5) {
+            let delta = light.a.xyz-i.world; let distance = length(delta);
+            l = delta/max(distance,0.0001);
+            att = atenuacao(distance,light.b.w) / max(distance*distance,0.01);
+            if (light.a.w > 1.5) { att *= cone(dot(-l,safe_unit(light.b.xyz)),light.d.x,light.d.y); }
+        }
+        let visibility = select(1.0,shadow,i32(k)==i32(env.info.y));
+        rgb += brdf(base,metallic,rough,n,v,l)*light.c.rgb*light.c.w*att*visibility;
+    }
+    rgb += pbr.emission.rgb*select(vec3<f32>(1.0),emission,pbr.maps.w>0.5);
+    return rgb;
+}
diff --git a/crates/rts-egui/src/frame/scene3d/pbr_gpu_tests.rs b/crates/rts-egui/src/frame/scene3d/pbr_gpu_tests.rs
