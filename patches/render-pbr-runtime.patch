new file mode 100644
--- /dev/null
+++ b/crates/rts-egui/src/frame/scene3d/mipmaps.rs
@@ -0,0 +1,116 @@
+//! Upload-time mip generation. Color maps are averaged in linear light;
+//! normal/MR/AO data maps must never receive an sRGB conversion.
+pub(crate) struct PreparedTexture {
+    pub levels: Vec<Vec<u8>>,
+    pub width: u32,
+    pub height: u32,
+    pub data: bool,
+}
+pub(crate) fn prepare(rgba: Vec<u8>, w: u32, h: u32, data: bool) -> PreparedTexture {
+    let mut result = PreparedTexture {
+        levels: vec![rgba],
+        width: w,
+        height: h,
+        data,
+    };
+    let (mut width, mut height) = (w, h);
+    while width > 1 || height > 1 {
+        let next = downsample(result.levels.last().unwrap(), width, height, data);
+        result.levels.push(next);
+        width = (width / 2).max(1);
+        height = (height / 2).max(1);
+    }
+    result
+}
+pub(super) fn upload_prepared(
+    queue: &wgpu::Queue,
+    tex: &wgpu::Texture,
+    prepared: &PreparedTexture,
+) {
+    let (mut w, mut h) = (prepared.width, prepared.height);
+    for (level, pixels) in prepared.levels.iter().enumerate() {
+        queue.write_texture(
+            wgpu::TexelCopyTextureInfo {
+                texture: tex,
+                mip_level: level as u32,
+                origin: wgpu::Origin3d::ZERO,
+                aspect: wgpu::TextureAspect::All,
+            },
+            pixels,
+            wgpu::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(w * 4),
+                rows_per_image: Some(h),
+            },
+            wgpu::Extent3d {
+                width: w,
+                height: h,
+                depth_or_array_layers: 1,
+            },
+        );
+        w = (w / 2).max(1);
+        h = (h / 2).max(1);
+    }
+}
+pub(super) fn linear(x: f32) -> f32 {
+    if x <= 0.04045 {
+        x / 12.92
+    } else {
+        ((x + 0.055) / 1.055).powf(2.4)
+    }
+}
+fn srgb(x: f32) -> f32 {
+    if x <= 0.0031308 {
+        x * 12.92
+    } else {
+        1.055 * x.powf(1.0 / 2.4) - 0.055
+    }
+}
+fn downsample(src: &[u8], w: u32, h: u32, data: bool) -> Vec<u8> {
+    let nw = (w / 2).max(1);
+    let nh = (h / 2).max(1);
+    let mut out = vec![0; (nw * nh * 4) as usize];
+    for y in 0..nh {
+        for x in 0..nw {
+            // Integer regions include the last row/column of odd-sized textures.
+            let (x0, x1) = (x * w / nw, (x + 1) * w / nw);
+            let (y0, y1) = (y * h / nh, (y + 1) * h / nh);
+            let count = ((x1 - x0) * (y1 - y0)) as f32;
+            for c in 0..4 {
+                let mut sum = 0.0;
+                for sy in y0..y1 {
+                    for sx in x0..x1 {
+                        let v = src[((sy * w + sx) * 4 + c) as usize] as f32 / 255.0;
+                        sum += if data || c == 3 { v } else { linear(v) };
+                    }
+                }
+                let v = sum / count;
+                out[((y * nw + x) * 4 + c) as usize] =
+                    ((if data || c == 3 { v } else { srgb(v) }) * 255.0).round() as u8;
+            }
+        }
+    }
+    out
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn color_is_filtered_in_linear_light_and_data_is_not() {
+        let pixels = [0, 0, 0, 255, 255, 255, 255, 255];
+        assert_eq!(downsample(&pixels, 2, 1, false), [188, 188, 188, 255]);
+        assert_eq!(downsample(&pixels, 2, 1, true), [128, 128, 128, 255]);
+    }
+    #[test]
+    fn odd_texture_includes_last_texel() {
+        assert_eq!(
+            downsample(
+                &[0, 0, 0, 255, 0, 0, 0, 255, 255, 255, 255, 255],
+                3,
+                1,
+                true
+            ),
+            [85, 85, 85, 255]
+        );
+    }
+}
