@@ -10,6 +10,44 @@ use crate::ctx::with_ctx;
 use crate::frame::scene3d::{model_matrix, model_matrix_quat, view_proj_lookat, view_proj_spec, CamSpec, Scene3D};
 use crate::frame::Backend;
 
+/// Upload/update a PBR material. Zero creates; invalid data returns zero.
+pub fn material_set(win: u64, id: u64, data: &[f64]) -> u64 {
+    with_scene(win, |s, d| s.set_material(d, id, data), 0)
+}
+pub fn material_free(win: u64, id: u64) { with_scene(win, |s, _| s.free_material(id), ()); }
+/// Capture queued 3D draws to PPM. Consumes that queue; excludes the UI overlay.
+pub fn capture_scene(win: u64, path: &str, width: i64, height: i64) -> bool {
+    if path.is_empty() || width <= 0 || height <= 0 || width > 4096 || height > 4096 { return false; }
+    with_ctx(win, |c| {
+        if let Backend::Wgpu(r) = &mut c.backend {
+            if let Some(scene) = &mut r.scene {
+                let result=scene.capture(&r.device,&r.queue,width as u32,height as u32,r.config.format)
+                    .and_then(|bytes| std::fs::write(path,bytes).map_err(|e|e.to_string()));
+                if let Err(error)=result {eprintln!("scene capture: {error}");return false;}
+                return true;
+            }
+        }
+        false
+    }).unwrap_or(false)
+}
+/// Used immediately after queueing a mesh; material zero preserves legacy shading.
+pub fn mesh_material(win: u64, id: u64) { with_scene(win, |s, _| s.last_material(id), ()); }
+/// Exposure multiplier. Zero disables tone mapping for existing scenes.
+pub fn set_exposure(win: u64, exposure: f64) {
+    if !exposure.is_finite() { return; }
+    with_scene(win, |s, _| s.set_exposure(exposure), ());
+}
+/// Linear data maps (normal, metallic/roughness, occlusion), not sRGB color.
+pub fn upload_data_texture(win: u64, rgba: &[u8], w: i64, h: i64) -> u64 {
+    if w <= 0 || h <= 0 || w > 16384 || h > 16384 || rgba.len() < w as usize*h as usize*4 { return 0; }
+    with_ctx(win, |c| {
+        if let Backend::Wgpu(r) = &mut c.backend {
+            if r.scene.is_none() { r.scene = Some(Scene3D::new(&r.device, &r.queue, r.config.format)); }
+            r.scene.as_mut().unwrap().upload_texture_kind(&r.device, &r.queue, rgba, w as u32, h as u32, true)
+        } else { 0 }
+    }).unwrap_or(0)
+}
