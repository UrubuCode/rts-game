--- /dev/null
+++ b/crates/rts-egui/src/frame/scene3d/water_surface.wgsl
@@ -0,0 +1,100 @@
+struct Cam {
+ view_proj:mat4x4<f32>,light:vec4<f32>,cam_pos:vec4<f32>,cam_right:vec4<f32>,cam_up:vec4<f32>,cam_fwd:vec4<f32>,light_vp:mat4x4<f32>,water:vec4<f32>,view_bg:vec4<f32>,proj:vec4<f32>,
+};
+struct Light {a:vec4<f32>,b:vec4<f32>,c:vec4<f32>,d:vec4<f32>};
+struct Env {info:vec4<f32>,amb:vec4<f32>,sky0:vec4<f32>,sky_top:vec4<f32>,sky_horizon:vec4<f32>,sky_ground:vec4<f32>,sun_dir:vec4<f32>,fog:vec4<f32>,lights:array<Light,8>};
+@group(0) @binding(0) var<uniform> cam:Cam;
+@group(0) @binding(1) var<uniform> env:Env;
+@group(1) @binding(0) var opaque:texture_2d<f32>;
+@group(1) @binding(1) var depth:texture_depth_2d;
+@group(1) @binding(2) var<uniform> viewport:vec4<f32>;
+struct Out {
+ @builtin(position) clip:vec4<f32>,@location(0) world:vec3<f32>,
+ @location(1) @interpolate(flat) wave:vec4<f32>,
+ @location(2) @interpolate(flat) params:vec4<f32>,
+ @location(3) @interpolate(flat) tint:vec4<f32>,
+ @location(4) @interpolate(flat) reflection:vec3<f32>,
+ @location(5) @interpolate(flat) origin:vec2<f32>,
+};
+// Ondas em coordenadas mundiais: superfícies vizinhas com parâmetros iguais se encontram.
+fn waves(p:vec2<f32>,w:vec4<f32>)->vec3<f32> {
+ let k=6.2831853/w.w;let a=k*(p.x*.8+p.y*.6)+w.y;
+ let b=k*1.7*(p.x*-.6+p.y*.8)+w.y*1.3;
+ return vec3<f32>(w.z*(sin(a)+.35*sin(b)),w.z*k*(.8*cos(a)-.357*cos(b)),w.z*k*(.6*cos(a)+.476*cos(b)));
+}
+@vertex fn vs(@builtin(vertex_index) vid:u32,@location(0) center:vec4<f32>,@location(1) wave:vec4<f32>,@location(2) params:vec4<f32>,@location(3) tint:vec4<f32>,@location(4) detail:vec4<f32>,@location(5) origin:vec4<f32>)->Out {
+ let corners=array<vec2<f32>,6>(vec2(0.,0.),vec2(1.,0.),vec2(0.,1.),vec2(1.,0.),vec2(1.,1.),vec2(0.,1.));
+ let cells=u32(detail.x);let cell=vid/6u;let uv=(vec2<f32>(f32(cell%cells),f32(cell/cells))+corners[vid%6u])/f32(cells);
+ let xz=center.xz+(uv-.5)*vec2(center.w,wave.x);
+ let w=vec4(wave.x,wave.y*params.x,wave.z,wave.w);
+ let world=vec3(xz.x,center.y+waves(xz+origin.xy,w).x,xz.y);
+ var o:Out;o.clip=cam.view_proj*vec4(world,1.);o.world=world;o.wave=w;o.params=params;o.tint=tint;o.reflection=detail.yzw;o.origin=origin.xy;return o;
+}
+fn view_depth(d:f32)->f32 {
+ let row=vec3(cam.view_proj[0][2],cam.view_proj[1][2],cam.view_proj[2][2]);
+ let a=dot(row,cam.cam_fwd.xyz);let b=dot(row,cam.cam_pos.xyz)+cam.view_proj[3][2];
+ if(cam.proj.x>.5){return (d-b)/a;}
+ return b/min(-.000001,d-a);
+}
+
+// Reflexo em screen space: somente geometria presente no depth opaco.
+fn scene_point(uv:vec2<f32>,d:f32)->vec3<f32> {
+ let xy=uv*vec2(2.,-2.)+vec2(-1.,1.);let z=view_depth(d);
+ if(cam.proj.x>.5){return cam.cam_pos.xyz+cam.cam_right.xyz*xy.x*cam.proj.z+cam.cam_up.xyz*xy.y*cam.proj.y+cam.cam_fwd.xyz*z;}
+ return cam.cam_pos.xyz+(cam.cam_fwd.xyz+cam.cam_right.xyz*xy.x*cam.cam_right.w+cam.cam_up.xyz*xy.y*cam.cam_up.w)*z;
+}
+fn scene_reflection(origin:vec3<f32>,direction:vec3<f32>,settings:vec3<f32>)->vec4<f32> {
+ if(settings.x<=0.){return vec4(0.);}
+ let steps=u32(clamp(settings.z,8.,48.));var previous=-1.;var last=.08;
+ for(var i=0u;i<48u;i++){
+  if(i>=steps){break;}
+  let fraction=f32(i+1u)/f32(steps);let distance=.15+settings.y*fraction*fraction;
+  let point=origin+direction*distance;if(point.y<origin.y-.1){continue;}
+  let clip=cam.view_proj*vec4(point,1.);if(clip.w<=0.){break;}
+  let ndc=clip.xyz/clip.w;let uv=ndc.xy*vec2(.5,-.5)+.5;
+  if(any(uv<vec2(0.))||any(uv>vec2(1.))||ndc.z>1.){break;}
+  let pixel=vec2<i32>(viewport.xy+uv*(viewport.zw-1.));let d=textureLoad(depth,pixel,0);
+  let difference=view_depth(ndc.z)-view_depth(d);
+  if(d<.99999&&difference>0.&&previous<=0.){
+   var low=last;var high=distance;var hitUV=uv;var hitDepth=d;var error=difference;
+   for(var j=0u;j<6u;j++){
+    let middle=(low+high)*.5;let sampleClip=cam.view_proj*vec4(origin+direction*middle,1.);
+    let sampleNdc=sampleClip.xyz/sampleClip.w;let sampleUV=sampleNdc.xy*vec2(.5,-.5)+.5;
+    let samplePixel=vec2<i32>(viewport.xy+clamp(sampleUV,vec2(0.),vec2(1.))*(viewport.zw-1.));
+    let sampleDepth=textureLoad(depth,samplePixel,0);let delta=view_depth(sampleNdc.z)-view_depth(sampleDepth);
+    if(delta>0.){high=middle;hitUV=sampleUV;hitDepth=sampleDepth;error=delta;}else{low=middle;}
+   }
+   // Recusa o leito submerso e saltos de profundidade nas silhuetas.
+   if(error<.12+high*.005&&scene_point(hitUV,hitDepth).y>=origin.y-.12){
+    let edge=min(min(hitUV.x,1.-hitUV.x),min(hitUV.y,1.-hitUV.y));
+    let hitPixel=vec2<i32>(viewport.xy+hitUV*(viewport.zw-1.));
+    return vec4(textureLoad(opaque,hitPixel,0).rgb,settings.x*smoothstep(0.,.08,edge)*(1.-fraction*.5));
+   }
+  }
+  previous=difference;last=distance;
+ }
+ return vec4(0.);
+}
+@fragment fn fs(o:Out)->@location(0) vec4<f32> {
+ let size=vec2<i32>(textureDimensions(opaque));let lo=vec2<i32>(viewport.xy);let hi=min(size-1,lo+vec2<i32>(viewport.zw)-1);let pixel=clamp(vec2<i32>(o.clip.xy),lo,hi);
+ let d=textureLoad(depth,pixel,0);let dz=max(0.,view_depth(d)-view_depth(o.clip.z));
+ let wave=waves(o.world.xz+o.origin,o.wave);
+ let phase=o.world.xz+o.origin;let ripple=.025*sin(phase.x*4.+phase.y*2.+o.wave.y*1.8);
+ let n=normalize(vec3(-wave.y+ripple,1.,-wave.z-ripple));
+ let v=normalize(cam.cam_pos.xyz-o.world);let f=.02+.98*pow(1.-max(0.,dot(n,v)),5.);
+ let shift=vec2<i32>(n.xz*o.params.w*min(dz,1.));
+ var refracted=clamp(pixel+shift,lo,hi);
+ if(textureLoad(depth,refracted,0)<o.clip.z){refracted=pixel;}
+ let background=textureLoad(opaque,refracted,0).rgb;
+ let absorption=1.-exp(-dz*o.tint.w);
+ let transmitted=mix(background,o.tint.rgb,absorption*o.params.z);
+ let reflected=reflect(-v,n);let sky=mix(env.sky_horizon.rgb,env.sky_top.rgb,pow(clamp(reflected.y,0.,1.),.5))*max(.2,env.sky0.y);
+ let sun=pow(max(0.,dot(reflected,normalize(-env.sun_dir.xyz))),180.)*vec3(3.,2.5,1.8);
+ let foam=(1.-smoothstep(0.,o.params.y,dz))*(.55+.25*sin(phase.x*7.+phase.y*4.+o.wave.y*2.));
+ let hit=scene_reflection(o.world+vec3(0.,.08,0.),reflected,o.reflection);
+ var color=mix(transmitted,mix(sky,hit.rgb,hit.a)+sun,f);color=mix(color,vec3(.8,.9,.85),foam*.8);
+ // A borda converge para a cena original quando a lâmina de água desaparece.
+ color=mix(background,color,smoothstep(0.,.08,dz));
+ let fog=1.-exp(-env.fog.w*length(cam.cam_pos.xyz-o.world));color=mix(color,env.fog.rgb,clamp(fog,0.,1.));
+ return vec4(color,1.);
+}
diff --git a/crates/rts-egui/src/texture_jobs.rs b/crates/rts-egui/src/texture_jobs.rs
new file mode 100644
--- /dev/null
+++ b/crates/rts-egui/src/texture_jobs.rs
@@ -0,0 +1,199 @@
+//! Background PNG read/decode/mipmap preparation; only GPU submission stays on UI.
+use crate::frame::{
+    Backend,
+    scene3d::mipmaps::{self, PreparedTexture},
+};
+use std::{
+    cell::RefCell,
+    collections::HashMap,
+    sync::{
+        Arc,
+        atomic::{AtomicU8, Ordering},
+        mpsc,
+    },
+};
+struct Job {
+    rx: mpsc::Receiver<Result<PreparedTexture, String>>,
+    stage: Arc<AtomicU8>,
+    error: String,
+}
+thread_local! {static JOBS:RefCell<(u64,HashMap<u64,Job>)>=RefCell::new((1,HashMap::new()));}
+fn decode(source: &str, stage: &AtomicU8) -> Result<PreparedTexture, String> {
+    let bytes = if source.starts_with("data:") {
+        rts_dom::imagem::bytes_da_data_url(source).ok_or("Invalid PNG data URI")?
+    } else {
+        std::fs::read(source).map_err(|e| e.to_string())?
+    };
+    if bytes.len() < 24 || bytes.len() > 64 * 1024 * 1024 {
+        return Err("Invalid PNG size".into());
+    }
+    let w = u32::from_be_bytes(bytes[16..20].try_into().unwrap());
+    let h = u32::from_be_bytes(bytes[20..24].try_into().unwrap());
+    if w == 0 || h == 0 || w > 4096 || h > 4096 {
+        return Err("PNG dimensions must be 1..4096".into());
+    }
+    stage.store(2, Ordering::Relaxed);
+    let (rgba, w, h) =
+        rts_dom::imagem::png::decodificar(&bytes).ok_or("Unsupported or corrupt PNG")?;
+    stage.store(3, Ordering::Relaxed);
+    let prepared = mipmaps::prepare(rgba, w, h, false);
+    stage.store(4, Ordering::Relaxed);
+    Ok(prepared)
+}
+pub fn texture_load_begin(source: String) -> u64 {
+    let (tx, rx) = mpsc::channel();
+    let stage = Arc::new(AtomicU8::new(1));
+    let worker_stage = stage.clone();
+    if std::thread::Builder::new()
+        .name("rts-texture-loader".into())
+        .spawn(move || {
+            let result = std::panic::catch_unwind(|| decode(&source, &worker_stage))
+                .unwrap_or_else(|_| Err("PNG worker failed".into()));
+            let _ = tx.send(result);
+        })
+        .is_err()
+    {
+        return 0;
+    }
+    JOBS.with(|jobs| {
+        let mut jobs = jobs.borrow_mut();
+        let id = jobs.0;
+        jobs.0 += 1;
+        jobs.1.insert(
+            id,
+            Job {
+                rx,
+                stage,
+                error: String::new(),
+            },
+        );
+        id
+    })
+}
+/// 0 pending, positive texture handle, -1 failed. Ready jobs are consumed.
+pub fn texture_load_poll(win: u64, id: u64) -> i64 {
+    let result = JOBS.with(|jobs| {
+        let mut jobs = jobs.borrow_mut();
+        let Some(job) = jobs.1.get_mut(&id) else {
+            return Some(Err("Unknown texture job".into()));
+        };
+        if !job.error.is_empty() {
+            return Some(Err(job.error.clone()));
+        }
+        match job.rx.try_recv() {
+            Ok(v) => Some(v),
+            Err(mpsc::TryRecvError::Empty) => None,
+            Err(_) => Some(Err("Texture worker disconnected".into())),
+        }
+    });
+    let Some(result) = result else {
+        return 0;
+    };
+    match result {
+        Ok(prepared) => {
+            let texture = crate::ctx::with_ctx(win, |c| {
+                if let Backend::Wgpu(r) = &mut c.backend {
+                    if let Some(scene) = &mut r.scene {
+                        scene.upload_prepared_texture(&r.device, &r.queue, &prepared)
+                    } else {
+                        0
+                    }
+                } else {
+                    0
+                }
+            })
+            .unwrap_or(0);
+            if texture > 0 {
+                texture_load_cancel(id);
+                texture as i64
+            } else {
+                set_error(id, "Scene GPU not initialized".into());
+                -1
+            }
+        }
+        Err(error) => {
+            set_error(id, error);
+            -1
+        }
+    }
+}
+fn set_error(id: u64, error: String) {
+    JOBS.with(|jobs| {
+        if let Some(job) = jobs.borrow_mut().1.get_mut(&id) {
+            job.error = error;
+        }
+    });
+}
+pub fn texture_load_error(id: u64) -> String {
+    JOBS.with(|jobs| {
+        jobs.borrow()
+            .1
+            .get(&id)
+            .map(|j| j.error.clone())
+            .unwrap_or_else(|| "Unknown texture job".into())
+    })
+}
+pub fn texture_load_progress(id: u64) -> f64 {
+    JOBS.with(|jobs| {
+        jobs.borrow()
+            .1
+            .get(&id)
+            .map(|j| match j.stage.load(Ordering::Relaxed) {
+                1 => 0.1,
+                2 => 0.3,
+                3 => 0.6,
+                _ => 0.9,
+            })
+            .unwrap_or(1.0)
+    })
+}
+pub fn texture_load_cancel(id: u64) {
+    JOBS.with(|jobs| {
+        jobs.borrow_mut().1.remove(&id);
+    });
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn png_pixels_and_mips_are_prepared_off_thread() {
+        let id=texture_load_begin("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAQAAAACCAYAAAB/qH1jAAAAFUlEQVR42mM4ISf3HxkzyMmd+I+MAQnlEBnT2GgUAAAAAElFTkSuQmCC".into());
+        let prepared = JOBS.with(|jobs| {
+            jobs.borrow()
+                .1
+                .get(&id)
+                .unwrap()
+                .rx
+                .recv_timeout(std::time::Duration::from_secs(3))
+                .unwrap()
+                .unwrap()
+        });
+        assert_eq!((prepared.width, prepared.height), (4, 2));
+        assert!(!prepared.data);
+        assert_eq!(
+            prepared.levels.iter().map(Vec::len).collect::<Vec<_>>(),
+            vec![32, 8, 4]
+        );
+        assert_eq!(&prepared.levels[0][0..4], &[200, 30, 30, 255]);
+        assert_eq!(&prepared.levels[0][16..20], &[30, 30, 200, 255]);
+        assert_eq!(texture_load_progress(id), 0.9);
+        texture_load_cancel(id);
+    }
+    #[test]
+    fn missing_file_fails_without_blocking_poll() {
+        let id = texture_load_begin("__missing_texture_test__.png".into());
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(3);
+        while texture_load_poll(0, id) == 0 {
+            assert!(std::time::Instant::now() < deadline);
+            std::thread::sleep(std::time::Duration::from_millis(1));
+        }
+        assert!(!texture_load_error(id).is_empty());
+        texture_load_cancel(id);
+    }
+    #[test]
+    fn cancel_discards_job() {
+        let id = texture_load_begin("__missing_texture_test__.png".into());
+        texture_load_cancel(id);
+        assert_eq!(texture_load_poll(0, id), -1);
+    }
+}
